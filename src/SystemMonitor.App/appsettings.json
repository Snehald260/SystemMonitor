{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Monitor": {
    "IntervalSeconds": 5,
    "DriveRoot": null
  },
  "FileLogger": {
    "Enabled": true,
    "FilePath": "logs/metrics.log"
  },
  "RestApi": {
    "Enabled": false,
    "Endpoint": "https://example.com/metrics",
    "TimeoutSeconds": 10
  }
}
